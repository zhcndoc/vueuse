FROM --platform=$BUILDPLATFORM node:24-bookworm AS builder

WORKDIR /app

RUN corepack enable pnpm

COPY . .

RUN pnpm install --frozen-lockfile

RUN pnpm run install-fonts && pnpm run docs:build

FROM ikxin/caddy:latest

COPY --from=builder /app/packages/.vitepress/dist /usr/share/caddy

EXPOSE 8080
